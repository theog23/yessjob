# ============================================
#  WEB — Variables de entorno (Vercel)
# ============================================

NEXT_PUBLIC_SUPABASE_URL=https://kgqnwqwzzbdsmaeokftc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Username del bot sin @ (debe coincidir con TELEGRAM_BOT_USERNAME del worker)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=tu_bot

# Service role key (Settings > API Keys > service_role). SECRETA — sin
# prefijo NEXT_PUBLIC_, nunca llega al navegador. Solo se usa server-side
# (Server Actions) para leer scraped_jobs, que no tiene policies de RLS,
# y para el RPC de cuota de generaciones (service_role-only).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# API key de Anthropic (console.anthropic.com). SECRETA. Se usa desde la
# Server Action de "Trabajos" para generar propuestas con IA sin salir
# del dashboard (mismo modelo que ya usa el worker de Telegram).
ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_MODEL=claude-sonnet-4-6
