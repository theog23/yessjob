# ============================================
#  WORKER — Variables de entorno
# ============================================

# --- SUPABASE ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...   # SERVICE ROLE, no anon

# --- TELEGRAM (bot unico) ---
TELEGRAM_BOT_TOKEN=1234567890:ABC...
TELEGRAM_BOT_USERNAME=tu_bot            # sin @, para armar t.me/tu_bot?start=<token>

# --- ANTHROPIC (Claude, propuestas IA) ---
ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_MODEL=claude-sonnet-4-6

# --- FREELANCER (opcional, mejora fiabilidad) ---
# Cookies opcionales pegadas del navegador (formato: k1=v1; k2=v2)
FREELANCER_COOKIES=

# --- SCRAPING ---
SCRAPE_LOOP_SECONDS=60          # frecuencia base del loop general
WORKANA_MAX_PAGES=2
FREELANCER_RESULTS_PER_RUN=20

# --- URL PUBLICA DEL FRONTEND (para links en mensajes) ---
APP_URL=https://tu-app.vercel.app
